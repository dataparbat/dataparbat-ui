{
  "name": "@dataparbat/ui",
  "version": "0.1.0",
  "description": "Design system for data-dense developer tools \u2014 token-contract theming, four-state discipline, a11y-first.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ui.css": "./src/ui.css",
    "./default-theme.css": "./src/default-theme.css"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@ladle/react": "^5.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "vite": "^6.3.0",
    "typescript": "^5.8.0"
  },
  "scripts": {
    "ladle": "ladle serve",
    "ladle:build": "ladle build",
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sendzila/dataparbat-ui"
  },
  "license": "MIT",
  "files": [
    "dist",
    "src/**/*.css",
    "LICENSE",
    "README.md"
  ]
}
